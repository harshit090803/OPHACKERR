# MongoDB
MONGO_URL="mongodb://localhost:27017"
DB_NAME="studypilot"
CORS_ORIGINS="*"

# Anthropic Claude
ANTHROPIC_API_KEY="your-anthropic-api-key"
ANTHROPIC_MODEL="claude-sonnet-4-5"
# Optional CA bundle. If empty, certifi is used.
ANTHROPIC_CA_BUNDLE=""
# Optional standard CA bundle path. Useful for corporate/proxy certificates.
SSL_CERT_FILE=""
# Set true only when the runtime must use HTTPS_PROXY/HTTP(S)_PROXY.
ANTHROPIC_TRUST_ENV="false"
# NEVER enable this in production/hackathon deployment.
ANTHROPIC_INSECURE_TLS="false"

# Microsoft Edge neural TTS
EDGE_TTS_VOICE="en-US-GuyNeural"
# In-memory audio cache size for low-latency lecture playback.
TTS_CACHE_MAX_MB="32"
